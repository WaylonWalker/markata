      "spacing": 1.25
    },
    "elevated": {
      "radius": "22px",
      "shadow": "0 24px 60px rgb(0 0 0 / .24)",
      "spacing": 1.15
    },
    "minimal": {
      "radius": "4px",
      "shadow": "none",
      "spacing": 0.9
    },
    "precision": {
      "radius": "4px",
      "shadow": "0 2px 7px rgb(0 0 0 / .10)",
      "spacing": 1
    }
  },
  "incomplete_palette_families": [],
  "derived_palette_counterparts": {
    "description": "Each former singleton family has an explicit counterpart. The counterpart keeps the source family and ID identity, and appends the missing variant suffix to its canonical ID.",
    "strategy": "Derived roles are produced by markata-go's palettes.DeriveCounterpart and synced with `go run ./scripts/rendering-contract --derive-palettes`. Raw colors are classified by how the source palette's semantic layer uses them. Surfaces convert sRGB to HSL, keep hue, scale saturation by 0.7, and are compressed into a 0.12-wide lightness band anchored at L=0.985 (light) or L=0.11 (dark) while preserving their relative order. Text colors reflect lightness (L to 1-L) and are then pushed away from the surfaces until they meet WCAG AA (7:1 for primary/secondary text, 4.5:1 for muted text) against every derived surface. Accents reflect lightness, clamp into a readable mid band (0.24-0.46 light, 0.56-0.80 dark), and are adjusted to 4.5:1 against the surfaces. Output channels round to 8-bit and serialize as lowercase #rrggbb. Counterparts keep the source family and append the missing variant suffix to the canonical ID.",
    "source_scope": "singleton_palette_families"
  },
