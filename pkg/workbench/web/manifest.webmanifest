{
  "name": "Markata Editor",
  "short_name": "Markata",
  "description": "Create and edit Markata posts from your phone",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#17142b",
  "theme_color": "#5629a4",
  "icons": [
    {
      "src": "/editor/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/editor/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/editor/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "New note",
      "short_name": "Note",
      "description": "Start a new note",
      "url": "/?compose=note",
      "icons": [
        {
          "src": "/editor/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New photo",
      "short_name": "Photo",
      "description": "Capture a photo post",
      "url": "/?compose=photo",
      "icons": [
        {
          "src": "/editor/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New link",
      "short_name": "Link",
      "description": "Start a link post",
      "url": "/?compose=link",
      "icons": [
        {
          "src": "/editor/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Share inbox",
      "short_name": "Inbox",
      "description": "Review saved links and photos",
      "url": "/?share_inbox=1",
      "icons": [
        {
          "src": "/editor/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
